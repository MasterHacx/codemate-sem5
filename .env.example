# CodeMate Sem 5 - Environment Configuration
# Copy to .env and fill in your values

# Firebase Web Config (from Firebase Console > Project Settings > General > Your apps > Web app)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=codemate-b8543.firebaseapp.com
FIREBASE_PROJECT_ID=codemate-b8543
FIREBASE_STORAGE_BUCKET=codemate-b8543.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=561969027206
FIREBASE_APP_ID=1:561969027206:web:fa4cef0f94373dc0939907

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-flask-secret-key-here

# Google Gemini API (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# Admin Credentials (for /admin panel)
ADMIN_USERNAME=akash
ADMIN_PASSWORD=your-secure-password-here

# Firebase Admin SDK Service Account (path to JSON file)
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json